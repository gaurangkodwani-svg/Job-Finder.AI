{
  "version": 2,
  "services": {
    "web_frontend": {
      "root": "frontend/"
    },
    "python_backend": {
      "root": "backend/",
      "entrypoint": "app.py"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "python_backend/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "web_frontend/$1"
    }
  ]
}